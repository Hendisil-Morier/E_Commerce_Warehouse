# ==============================================================================
# Cấu hình Môi trường cho E-Commerce Warehouse
# Sao chép file này thành .env trước khi chạy docker-compose hoặc ứng dụng
# ==============================================================================

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ECommerceWarehouse
DB_USER=appuser
DB_PASSWORD=apppassword
DB_ROOT_PASSWORD=123456

# Adminer (Web Database Management)
ADMINER_PORT=8080

# Backend Connection String (.NET 9)
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=ECommerceWarehouse;User=root;Password=123456;CharSet=utf8mb4;"

# JWT Settings
JwtSettings__Secret="YourSuperSecretKeyForJwtTokenGeneration2026ECommerceWarehouseTeam4!"
JwtSettings__Issuer="ECommerceWarehouseAPI"
JwtSettings__Audience="ECommerceWarehouseClient"
JwtSettings__AccessTokenExpirationMinutes=60

# Auth OTP Secret (dùng HMAC-SHA256 băm OTP, đặt giá trị mạnh trong .env hoặc user-secrets)
Auth__OtpSecret=""

# Google OAuth2 Client ID (Web application)
GoogleAuth__ClientId=""
VITE_GOOGLE_CLIENT_ID=""

# Email SMTP Settings (ví dụ Gmail: smtp.gmail.com, port 587, STARTTLS + App Password)
EmailSettings__Host="smtp.gmail.com"
EmailSettings__Port=587
EmailSettings__User=""
EmailSettings__Password=""
EmailSettings__FromName="KHO SÀN+"
EmailSettings__FromAddress=""

# Frontend API URL (Vite)
VITE_API_BASE_URL="http://localhost:5126"
